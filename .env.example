# ── Server ────────────────────────────────────────────────────────────────────
# PORT is set automatically by Railway. For VPS / local development:
PORT=5000

# ── Authentication (optional but strongly recommended in production) ───────────
# Set to any secret string. Pass in every request as:
#   Header:  X-API-Key: <value>
#   or Query: ?api_key=<value>
# Leave empty to run in open/dev mode (no auth).
API_KEY=

# ── Rate limiting ──────────────────────────────────────────────────────────────
# Maximum requests per IP per window.
RATE_LIMIT=10
# Window duration in seconds.
RATE_WINDOW=60

# ── CAPTCHA solving (/shopii endpoint) ────────────────────────────────────────
# API key for a 2captcha-compatible solving service.
# Supported services (all use the same 2captcha API format):
#   2captcha   → https://2captcha.com          (set CAPTCHA_SOLVER_URL to default)
#   CapMonster → https://api.capmonster.cloud  (set CAPTCHA_SOLVER_URL accordingly)
#   Anti-Captcha, etc.
# Leave empty to disable CAPTCHA solving (CAPTCHA_REQUIRED will be returned).
CAPTCHA_SOLVER_KEY=

# Base URL of the solving service. Defaults to https://2captcha.com if not set.
CAPTCHA_SOLVER_URL=https://2captcha.com
